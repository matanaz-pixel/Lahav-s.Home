# סודות לעולם לא נכנסים לקוד. העתק ל-.env ומלא.

# ספק המודל: gemini (חינמי, ברירת מחדל) או anthropic (Claude, בתשלום)
LLM_PROVIDER=gemini
# מפתח חינמי מ-https://aistudio.google.com/apikey
GEMINI_API_KEY=
# נדרש רק אם LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# אופציונלי: שם מודל. ברירת מחדל: gemini-2.5-flash / claude-sonnet-5-5
LLM_MODEL=

TELEGRAM_BOT_TOKEN=
# מזהה הצ'אט של מתן בטלגרם (רק הוא מורשה לשלוט בבוט)
OWNER_TELEGRAM_ID=
DATA_DIR=./data
